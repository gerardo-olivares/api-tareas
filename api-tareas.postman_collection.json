{
  "info": {
    "name": "API de Tareas — Actividad 3",
    "description": "Colección para probar la API. Ejecuta primero \"Login\" para guardar el token automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tareaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registro (POST /register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Gerardo Olivares\",\n  \"email\": \"gerardo@ejemplo.com\",\n  \"password\": \"Tareas2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (POST /login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); console.log('Token guardado'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerardo@ejemplo.com\",\n  \"password\": \"Tareas2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerardo@ejemplo.com\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Tareas (CRUD protegido)",
      "item": [
        {
          "name": "Listar tareas (GET /tareas)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ]
            }
          }
        },
        {
          "name": "Crear tarea (POST /tareas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.tarea) pm.collectionVariables.set('tareaId', r.tarea.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Entregar la Actividad 3\",\n  \"descripcion\": \"Subir el zip con server.js, tareas.json, el Word y el video.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ver una tarea (GET /tareas/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas/{{tareaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas",
                "{{tareaId}}"
              ]
            }
          }
        },
        {
          "name": "Actualizar tarea (PUT /tareas/:id)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas/{{tareaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas",
                "{{tareaId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Entregar la Actividad 3 (revisada)\",\n  \"completada\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar tarea (DELETE /tareas/:id)",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas/{{tareaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas",
                "{{tareaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Protección y errores",
      "item": [
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ]
            }
          }
        },
        {
          "name": "Token inválido (403)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token.falso.123",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ]
            }
          }
        },
        {
          "name": "Tarea sin título (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Falta el título\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Tarea inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tareas/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas",
                "no-existe"
              ]
            }
          }
        },
        {
          "name": "Ruta inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/ruta-que-no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ruta-que-no-existe"
              ]
            }
          }
        }
      ]
    }
  ]
}